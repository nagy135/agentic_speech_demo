# Required. This stays on the server; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# GPT-Live uses gpt-live-1. Voice and delegation settings are in the website UI.

# Optional Docker host port. nixpi uses 13004 behind nginx.
APP_PORT=3000

# Log setup, GPT-Live sideband events, and outgoing time nudges to server stdout.
# Time nudges run every 30 seconds regardless of this flag.
DEBUG_MODE=false
